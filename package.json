{
  "name": "skripsi-temperature-prediction-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Node.js untuk prediksi suhu ruang server dan penyimpanan MySQL",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:prod",
    "start:dev": "NODE_ENV=development node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "sync:influx": "node src/sync-influx.js",
    "test": "NODE_ENV=test node --test",
    "start:a1": "NODE_ENV=development node src/server-a1.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.14.0"
  }
}
