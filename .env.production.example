# Salin menjadi .env.production untuk menguji konfigurasi production dari komputer lokal.
PORT=3000
MYSQL_HOST=ganti_dengan_host_aiven
MYSQL_PORT=ganti_dengan_port_aiven
MYSQL_USER=ganti_dengan_user_aiven
MYSQL_PASSWORD=ganti_dengan_password_aiven
MYSQL_DATABASE=skripsi_suhu
MYSQL_CONNECTION_LIMIT=2
MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SNAPSHOT_INGEST_TOKEN=ganti_dengan_token_production_yang_acak
ENABLE_LEGACY_ARCHITECTURE=false
FRONTEND_DIST=../web_frontend/dist
